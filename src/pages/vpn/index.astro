  <script is:inline>
    // 弹窗控制逻辑
    const modal = document.getElementById('security-reminder-modal');
    const closeX = document.getElementById('close-reminder-x');
    const closeBtn = document.getElementById('close-reminder-btn');
    const jumpBtn = document.getElementById('jump-to-brands-btn');

    function openSecurityReminderModal() {
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden'; // 防止底层滚动穿透
      }
    }

    function closeSecurityReminderModal() {
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    if (closeX) closeX.addEventListener('click', closeSecurityReminderModal);
    if (closeBtn) closeBtn.addEventListener('click', closeSecurityReminderModal);
    if (jumpBtn) {
      jumpBtn.addEventListener('click', () => {
        closeSecurityReminderModal();
        const target = document.getElementById('brands-comparison');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeSecurityReminderModal();
        }
      });
    }

    // 隐藏测试订阅链接，点击后 10 秒倒计时解锁，直接复制到剪贴板并主动弹出【重要使用提醒】
    document.querySelectorAll('.unlock-action-area').forEach(area => {
      const btn = area.querySelector('.unlock-node-btn');
      const tipBox = area.querySelector('.copy-success-tip');
      const footnote = area.querySelector('.unlock-footnote');
      const url = area.dataset.url;

      async function silentCopy(text) {
        if (!text) return false;
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
            return true;
          }
        } catch (e) {
          // ignore
        }
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          ta.style.top = '-9999px';
          ta.setAttribute('readonly', '');
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          document.body.removeChild(ta);
          return ok;
        } catch (err) {
          return false;
        }
      }

      if (btn) {
        btn.addEventListener('click', () => {
          const iconSpan = btn.querySelector('.btn-icon');
          const textSpan = btn.querySelector('.btn-text');

          // 若已经解锁，直接再次复制并弹出【重要使用提醒】
          if (btn.classList.contains('unlocked')) {
            silentCopy(url);
            openSecurityReminderModal();
            const originalText = textSpan.textContent;
            textSpan.textContent = '✅ 已再次复制！请查阅重要提醒';
            setTimeout(() => {
              textSpan.textContent = originalText;
            }, 2500);
            return;
          }

          // 尚未解锁：启动 10 秒倒计时
          btn.disabled = true;
          let remaining = 10;
          if (iconSpan) iconSpan.textContent = '⏳';
          if (textSpan) textSpan.textContent = `正在生成加密配置，请稍候 (${remaining}s)...`;

          const timer = setInterval(() => {
            remaining--;
            if (remaining > 0) {
              if (textSpan) textSpan.textContent = `正在生成加密配置，请稍候 (${remaining}s)...`;
            } else {
              clearInterval(timer);
              btn.disabled = false;
              btn.classList.add('unlocked');
              if (iconSpan) iconSpan.textContent = '✅';
              if (textSpan) textSpan.textContent = '已复制免费订阅！点击可再次复制';
              if (tipBox) tipBox.style.display = 'block';
              if (footnote) footnote.textContent = '💡 订阅链接已写入剪贴板，请牢记安全须知，直接在客户端粘贴即可。';
              
              // 复制订阅，并立刻弹出【重要使用提醒】
              silentCopy(url);
              openSecurityReminderModal();
            }
          }, 1000);
        });
      }
    });

    // 动态注入当日实时日期到免费节点每日更新徽章
    try {
      const now = new Date();
      const dateStr = `${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日`;
      document.querySelectorAll('[data-daily-sync]').forEach(el => {
        el.textContent = `今日已自动同步（${dateStr}）`;
      });
    } catch (e) {
      // ignore
    }
  </script>
