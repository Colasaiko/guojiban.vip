---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { allBrands } from '../../data/brands';
import { reviewsDetailMap } from '../../data/reviewsDetail';
import { site } from '../../data/site';
import SpeedTestReportCard from '../../components/SpeedTestReportCard.astro';

const primaryBrands = allBrands.filter(b => b.category === 'primary');
const extendedBrands = allBrands.filter(b => b.category === 'extended');

const auditCriteria = [
  { icon: '⏱️', title: '晚高峰测速与抗拥堵', desc: '在晚上 20:00~23:00 网络极度拥挤时段持续压测下行带宽与丢包率，杜绝虚标假专线。' },
  { icon: '🤖', title: '海外 AI 生产力支持', desc: '检验对 ChatGPT Plus、Claude 3.5 Sonnet 及 Midjourney 等严格封控平台的原生连通度。' },
  { icon: '🎬', title: '4K/8K 流媒体全解锁', desc: '核验是否拥有原生家庭住宅 IP，确保 Netflix、Disney+ 与 YouTube 高码率播放不锁区。' },
  { icon: '🛡️', title: '退款机制与工单响应', desc: '考察技术团队的故障修复时效、敏感期备用容灾方案以及透明合理的售后条款。' }
];
---
<BaseLayout
  title={`梯子品牌深度测评大全 · 2026全部主流服务商实测文章与跑分排行 · ${site.name}`}
  description="国际版VIP 深度测评中心：收录全部 35 款主流梯子品牌实测文章。涵盖微风网络、飞猫云、暮光加速、大佬云、萤火虫等，全方位实测晚高峰带宽、延迟丢包、ChatGPT与流媒体解锁，点击即可查看每家品牌的专属评测文章。"
>
  <div class="container">
    <Breadcrumb items={[{ label: '梯子推荐', href: '/vpn/' }, { label: '品牌测评' }]} />

    <header class="page-heading">
      <span class="eyebrow">IN-DEPTH BENCHMARK & REVIEWS · 全部品牌测评中心</span>
      <h1>梯子品牌深度测评大全与性能实测档案</h1>
      <p>面对市面上形形色色的梯子服务商，究竟谁的专线更靠谱？国际版VIP 搭建三网跨省实测环境，长期追踪全部主流品牌的晚高峰表现。点击任意品牌卡片中的<strong>“阅读详细测评文章”</strong>，即可进入查看该品牌的专线质量、测速跑分、真实优缺点与避坑指引。</p>
    </header>

    <!-- 站长中立声明与月付提示 -->
    <div class="aff-tip-card" style="margin-bottom: 35px;">
      <span class="aff-tip-badge">⚖️ 测评中立声明与选购提醒</span>
      <div class="aff-tip-body">
        <strong>实测数据说明与核心原则</strong>
        <p>所有评测文章均基于真实网络测试环境客观撰写。<strong>请牢记站长核心原则：无论测评文章得分多高，购买时请务必先尝试一个月月付套餐！</strong>在您自己的本地网络测试满意后，再考虑长期续费，切勿盲目直接购买一年。</p>
      </div>
    </div>

    <!-- 测评标准四重维度 -->
    <section class="section" style="padding-top: 10px; padding-bottom: 35px;">
      <div class="section-heading">
        <div>
          <span class="eyebrow">AUDIT METHODOLOGY</span>
          <h2>严格实测的四大考核维度</h2>
          <p class="muted">拒绝假大空云评测，用真实测速与功能核验揭示品牌底色。</p>
        </div>
      </div>

      <div class="guidance-grid">
        {auditCriteria.map(item => (
          <div class="guidance-card">
            <span style="font-size: 26px; display: block; margin-bottom: 10px;">{item.icon}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 站长核心主推品牌测评文章专区 -->
    <section class="section" style="padding-top: 10px; padding-bottom: 35px;">
      <div class="section-heading">
        <div>
          <span class="eyebrow">FEATURED REVIEWS</span>
          <h2>站长核心主推品牌测评（TOP 09）</h2>
          <p class="muted">经过多轮严苛压测综合实力最突出的 9 大首选品牌，点击可进入查看完整测评文章。</p>
        </div>
        <span class="section-index">09 BRANDS</span>
      </div>

      <div class="reviews-list">
        {primaryBrands.map((b, idx) => (
          <article class="review-card">
            <!-- 顶部头信息 -->
            <div class="review-card-top">
              <div class="review-brand-meta">
                <span class="review-badge-num">{idx + 1 < 10 ? `0${idx + 1}` : idx + 1}</span>
                <div class="review-brand-title">
                  <h3>
                    <a href={`/reviews/${b.slug}/`} style="color: #ffffff; text-decoration: none;">
                      {b.name}
                    </a>
                    <span class="bp-tag" style="font-size: 11px;">{b.couponDiscount}</span>
                  </h3>
                  <span class="review-tag-line">{reviewsDetailMap[b.slug]?.subtitle || b.tag}</span>
                </div>
              </div>

              <div class="review-score-box">
                <div>
                  <span class="rs-label">骨干架构</span>
                  <div style="display: flex; align-items: baseline; gap: 4px;">
                    <span class="rs-num" style="font-size: 16px; color: #60a5fa;">{b.lineType}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- 核心规格指标 -->
            <div class="review-metrics-grid">
              <div class="rm-item">
                <span class="rm-label">最低套餐起步</span>
                <span class="rm-value" style="color: #60a5fa;">🏷️ {b.minMonthly}</span>
              </div>
              <div class="rm-item">
                <span class="rm-label">骨干线路架构</span>
                <span class="rm-value">🌐 {b.lineType}</span>
              </div>
              <div class="rm-item">
                <span class="rm-label">晚高峰实测下行</span>
                <span class="rm-value">⚡ {b.speed}</span>
              </div>
              <div class="rm-item">
                <span class="rm-label">核心节点延迟</span>
                <span class="rm-value">📶 {b.latency}</span>
              </div>
            </div>

            <!-- 使用方式专属提示条 -->
            <div style="background: rgba(245, 158, 11, 0.06); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 8px; padding: 8px 12px; margin-bottom: 14px; font-size: 12px; color: #fef08a;">
              📲 <strong>使用方式：</strong>{
                b.slug === 'weifeng'
                  ? '官方专属客户端，iOS 采用 Nextin 识别码接入（不提供明文通用订阅链接）'
                  : b.slug === 'wuyou'
                  ? 'iOS / Android / Windows / macOS 四平台官方自研客户端，一键登录即用'
                  : b.slug === 'firefly'
                  ? '官方专属客户端与通用订阅导入，全平台自研协议深度优化'
                  : b.slug === 'dalao'
                  ? '官方专属免配置客户端，同时支持 Shadowsocks 协议订阅导入'
                  : '官方专属客户端，下载登录即用 / 支持多端通用标准订阅导入'
              }
            </div>

            <!-- 专属测评大标题与简评 -->
            <h4 style="font-size: 14px; font-weight: 700; color: #60a5fa; margin-bottom: 8px;">
              <a href={`/reviews/${b.slug}/`} style="color: inherit; text-decoration: none;">
                {reviewsDetailMap[b.slug]?.h1 || `${b.name}深度测评`}
              </a>
            </h4>
            <p class="review-body" style="margin-bottom: 16px;">
              {b.summary}
            </p>

            <!-- 06 测速与节点响应报告（与测评文章第 06 章节同源） -->
            <SpeedTestReportCard brandSlug={b.slug} titleSuffix="06 节点延迟与测速实测" />

            <!-- 底部操作栏 -->
            <div class="review-bottom-bar">
              <div class="review-coupon-area" style="display: flex; align-items: center; gap: 6px;">
                <span>专属折扣：</span>
                <code style="background: rgba(255, 255, 255, 0.1); color: #fff; padding: 2px 6px; border-radius: 4px;">{b.coupon}</code>
                {b.coupon !== '无需优惠码' && (
                  <button
                    type="button"
                    class="mini-copy-btn list-copy-btn"
                    data-code={b.coupon}
                    title="点击复制优惠码"
                    style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.18); color: #cbd5e1; font-size: 11px; padding: 2px 7px; border-radius: 4px; cursor: pointer;"
                  >
                    复制 📋
                  </button>
                )}
                <span style="font-size: 11px; color: #fcd34d; font-weight: 600;">（{b.couponDiscount}）</span>
              </div>

              <div class="review-actions">
                <a
                  href={`/reviews/${b.slug}/`}
                  class="button primary"
                  style="font-size: 13px; font-weight: 700; padding: 10px 18px;"
                >
                  阅读详细测评文章 →
                </a>
                <a
                  href={`/go/${b.slug}/`}
                  target="_blank"
                  rel="nofollow noopener noreferrer sponsored"
                  class="button secondary"
                  style="font-size: 13px; padding: 10px 16px;"
                >
                  前往官网 ↗
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 全网主流扩展品牌测评文章列表 -->
    <section class="section" style="padding-top: 10px; padding-bottom: 45px;">
      <div class="section-heading">
        <div>
          <span class="eyebrow">EXTENDED DIRECTORY REVIEWS</span>
          <h2>全网主流扩展品牌测评档案（共 {extendedBrands.length} 款）</h2>
          <p class="muted">涵盖不同预算、协议偏好（V2Ray/Shadowsocks/Trojan/Hysteria2）及不限时按量计费的备选品牌。</p>
        </div>
        <span class="section-index">{extendedBrands.length} BRANDS</span>
      </div>

      <div class="resource-grid">
        {extendedBrands.map(b => (
          <div class="resource-card">
            <div class="resource-top">
              <div class="resource-identity">
                <span class="resource-icon" style="color: var(--gold);">📊</span>
                <div style="min-width: 0;">
                  <div class="resource-name-row">
                    <h3 title={b.name}>{b.name}</h3>
                    <span class="resource-tag">{b.lineType}</span>
                  </div>
                  <span class="resource-domain">优惠码: {b.coupon}</span>
                </div>
              </div>
            </div>

            <p class="resource-desc">{reviewsDetailMap[b.slug]?.subtitle || b.summary}</p>

            <div class="bp-features" style="margin-bottom: 12px;">
              <span>⚡ {b.speed}</span>
              <span>📶 {b.latency}</span>
              <span>🏷️ {b.minMonthly}</span>
              <span>{b.couponDiscount}</span>
            </div>

            <!-- 06 实测数据速查抽屉（与测评文章第 06 章节同源） -->
            <details class="resource-speed-details" style="margin-top: 8px; margin-bottom: 12px; font-size: 12px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; padding: 6px 10px;">
              <summary style="cursor: pointer; color: #94a3b8; font-weight: 500; display: flex; align-items: center; justify-content: space-between;">
                <span>⚡ 展开 06 节点测速报告</span>
                <span style="font-size: 11px; color: #64748b;">实时同步</span>
              </summary>
              <div style="margin-top: 8px;">
                <SpeedTestReportCard brandSlug={b.slug} titleSuffix="实测" />
              </div>
            </details>

            <div class="resource-actions" style="margin-top: auto; display: flex; gap: 8px;">
              <a
                href={`/reviews/${b.slug}/`}
                class="button primary"
                style="flex: 1; text-align: center; font-size: 12px; padding: 9px;"
              >
                查看测评文章 →
              </a>
              <a
                href={`/go/${b.slug}/`}
                target="_blank"
                rel="nofollow noopener noreferrer sponsored"
                class="button secondary"
                style="flex: 1; text-align: center; font-size: 12px; padding: 9px;"
              >
                官网 ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 底部收尾引导 -->
    <section class="closing">
      <span class="eyebrow">NEED RECOMMENDATIONS?</span>
      <h2>需要具体的梯子对比与免费节点测试？</h2>
      <p class="muted" style="margin-top: 10px; font-size: 13px;">前往梯子推荐专题页，查看品牌 vs 免费节点的对决对比，以及一键复制测试订阅。</p>
      <div style="margin-top: 25px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/vpn/" class="button primary">前往【梯子推荐】专题页面 ↗</a>
        <a href="/brands/" class="button secondary">浏览完整【梯子品牌库】档案 →</a>
      </div>
    </section>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const copyBtns = document.querySelectorAll('.list-copy-btn');
      copyBtns.forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          const code = btn.getAttribute('data-code');
          if (!code || code === '无需优惠码') return;

          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(code);
            } else {
              const ta = document.createElement('textarea');
              ta.value = code;
              ta.style.position = 'fixed';
              ta.style.left = '-9999px';
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }

            const originalText = btn.textContent;
            btn.textContent = '已复制 ✓';
            btn.style.color = '#6ee7b7';
            setTimeout(() => {
              btn.textContent = originalText;
              btn.style.color = '';
            }, 2000);
          } catch (err) {
            console.error('复制失败:', err);
          }
        });
      });
    });
  </script>
</BaseLayout>
