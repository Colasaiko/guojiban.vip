---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categories, categoryHref } from '../../data/site';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b) => +b.data.pubDate - +a.data.pubDate);
---
<BaseLayout title="海外App使用教程大全：下载、注册与打不开排查" description="收录ChatGPT、Claude、TikTok、Telegram、YouTube、Netflix等海外App与网站的使用教程，包含官方入口、下载注册方法、国内打不开的原因，以及挂了梯子仍用不了时的排查步骤。"><div class="container"><Breadcrumb items={[{label:'全部文章'}]} /><header class="page-heading"><span class="eyebrow">THE READING ROOM</span><h1>海外App使用教程：下载、注册与打不开排查</h1><p>用途介绍、平台差异与使用常识，逐步整理成一份中文指南。</p></header><nav class="filter-nav" aria-label="按分类浏览"><a class="selected" href="/blog/">全部内容</a>{categories.map(c => <a href={categoryHref(c.slug)}>{c.name}</a>)}</nav><div class="notice">💡 <strong>阅读提示</strong>：本文库收录海外核心热门应用的新手教程与排查指南。由于多数海外服务受国内网络限制，如遇官网打不开或注册一直加载，建议先参考 <a href="/tizi/" style="color: var(--gold); text-decoration: underline; font-weight: 700;">2026 梯子推荐与选购指南 ↗</a> 配置稳定专线。</div><div class="article-grid section">{posts.map(post => <ArticleCard post={post} />)}</div></div></BaseLayout>
