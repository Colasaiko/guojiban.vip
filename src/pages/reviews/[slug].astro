  <script is:inline>
    // 测试截图放大查看：点击外面或按 Esc 关闭，支持按钮与滚轮缩放
    (() => {
      const box = document.getElementById('lightbox');
      if (!box) return;
      const img = box.querySelector('.lb-img');
      const cap = box.querySelector('.lb-cap');
      const stage = box.querySelector('.lb-stage');
      let scale = 1;
      let fitWidth = 0;

      const apply = () => { img.style.width = `${Math.round(fitWidth * scale)}px`; };
      const fit = () => {
        const maxW = window.innerWidth * 0.92;
        const maxH = window.innerHeight * 0.78;
        const ratio = img.naturalWidth / img.naturalHeight || 1;
        fitWidth = Math.min(maxW, maxH * ratio, img.naturalWidth * 2);
        apply();
      };
      const zoom = (factor) => { scale = Math.min(5, Math.max(0.5, scale * factor)); apply(); };
      const open = (src, alt, caption) => {
        scale = 1;
        img.onload = fit;
        img.src = src;
        img.alt = alt;
        cap.textContent = caption || '';
        box.hidden = false;
        document.body.style.overflow = 'hidden';
        if (img.complete) fit();
      };
      const close = () => {
        box.hidden = true;
        document.body.style.overflow = '';
      };

      document.querySelectorAll('.lt-zoom').forEach(a => {
        a.addEventListener('click', e => {
          e.preventDefault();
          const thumb = a.querySelector('img');
          open(a.getAttribute('href'), thumb ? thumb.alt : '', a.dataset.caption);
        });
      });
      box.querySelector('.lb-toolbar').addEventListener('click', e => {
        const act = e.target.closest('button')?.dataset.act;
        if (act === 'in') zoom(1.25);
        if (act === 'out') zoom(0.8);
        if (act === 'reset') { scale = 1; apply(); }
        if (act === 'close') close();
      });
      // 点图片以外的区域即关闭
      box.addEventListener('click', e => {
        if (e.target === box || e.target === stage) close();
      });
      stage.addEventListener('wheel', e => {
        e.preventDefault();
        zoom(e.deltaY < 0 ? 1.1 : 0.9);
      }, { passive: false });
      document.addEventListener('keydown', e => {
        if (box.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === '+' || e.key === '=') zoom(1.25);
        if (e.key === '-') zoom(0.8);
      });
      window.addEventListener('resize', () => { if (!box.hidden) fit(); });
    })();
    // 优惠代码一键复制与即时反馈交互
    function initCouponCopy() {
      const copyButtons = document.querySelectorAll('.btn-copy-coupon, .mini-copy-btn, .sb-mini-copy-btn');
      copyButtons.forEach(btn => {
        btn.onclick = async (e) => {
          e.preventDefault();
          const code = btn.getAttribute('data-code');
          if (!code || code === '无需优惠码') return;

          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(code);
            } else {
              const ta = document.createElement('textarea');
              ta.value = code;
              ta.style.position = 'fixed';
              ta.style.left = '-9999px';
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }

            const textEl = btn.querySelector('.copy-text') || btn.querySelector('.mini-copy-action');
            const iconEl = btn.querySelector('.copy-icon');
            const originalText = textEl ? textEl.textContent : '';

            btn.classList.add('is-copied');
            if (textEl) textEl.textContent = '已复制！';
            if (iconEl) iconEl.textContent = '✅';

            setTimeout(() => {
              btn.classList.remove('is-copied');
              if (textEl) textEl.textContent = originalText;
              if (iconEl) iconEl.textContent = '📋';
            }, 2500);
          } catch (err) {
            console.error('Copy failed:', err);
          }
        };
      });
    }

    // 目录游览实时跟随与章节高亮监听（ScrollSpy）
    function initScrollSpy() {
      const sections = document.querySelectorAll('.module-block[id]');
      const navLinks = document.querySelectorAll('.sn-list .toc-link');

      if (!sections.length || !navLinks.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach(link => {
              if (link.getAttribute('href') === `#${id}`) {
                link.classList.add('active-nav-link');
              } else {
                link.classList.remove('active-nav-link');
              }
            });
          }
        });
      }, {
        rootMargin: '-100px 0px -65% 0px',
        threshold: 0
      });

      sections.forEach(sec => observer.observe(sec));
    }

    // 移动端浮动目录弹窗抽屉
    function initMobileToc() {
      const toggleBtn = document.getElementById('mobile-toc-toggle');
      const closeBtn = document.getElementById('mobile-toc-close');
      const backdrop = document.getElementById('mobile-toc-backdrop');
      const modal = document.getElementById('mobile-toc-modal');
      const modalLinks = document.querySelectorAll('.mobile-modal-link');

      if (!toggleBtn || !modal) return;

      function openModal() {
        modal.classList.add('open');
      }

      function closeModal() {
        modal.classList.remove('open');
      }

      toggleBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (backdrop) backdrop.addEventListener('click', closeModal);

      modalLinks.forEach(link => {
        link.addEventListener('click', () => {
          closeModal();
        });
      });
    }

    // 交互式套餐周期切换器（同一个套餐粘在一起，点击周期其他价格联动变化）
    function initInteractivePricingTable() {
      const table = document.getElementById('package-pricing-table');
      if (!table) return;

      const rows = table.querySelectorAll('.package-pricing-row');
      const couponDiscountEl = document.querySelector('.c-discount');
      const couponDiscount = couponDiscountEl ? couponDiscountEl.textContent.trim() : '';

      // 1. 每行内部周期药丸点击事件
      rows.forEach(row => {
        const periodsDataStr = row.getAttribute('data-periods');
        if (!periodsDataStr) return;
        let periodsData = [];
        try {
          periodsData = JSON.parse(periodsDataStr);
        } catch (e) {
          return;
        }

        const pillButtons = row.querySelectorAll('.period-pill-btn');
        const origEl = row.querySelector('.row-orig-price');
        const discWrap = row.querySelector('.row-disc-wrap');
        const monthlyEl = row.querySelector('.monthly-avg-tag');

        pillButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const idx = parseInt(btn.getAttribute('data-period-index') || '0', 10);
            const p = periodsData[idx];
            if (!p) return;

            // 切换选中高亮
            pillButtons.forEach(b => b.classList.remove('is-active'));
            btn.classList.add('is-active');

            // 更新官方原价（添加发光刷新动画）
            if (origEl) {
              origEl.textContent = p.originalPrice;
              origEl.classList.remove('price-flash');
              void origEl.offsetWidth;
              origEl.classList.add('price-flash');
            }

            // 更新券后折后价（保持原生DOM结构，保留边框框架与高亮样式）
            const discPriceEl = row.querySelector('.row-disc-price');
            const discPillEl = row.querySelector('.row-disc-pill');
            const discNoteEl = row.querySelector('.row-disc-note');

            if (discPriceEl) {
              discPriceEl.textContent = p.discountPrice || p.originalPrice;
              discPriceEl.classList.remove('price-flash');
              void discPriceEl.offsetWidth;
              discPriceEl.classList.add('price-flash');
            }

            if (discPillEl && discNoteEl) {
              const hasDiscount = Boolean(p.discountPrice && couponDiscount && couponDiscount !== '官方正价');
              if (hasDiscount) {
                discPillEl.style.display = 'inline-block';
                discPillEl.classList.remove('price-flash');
                void discPillEl.offsetWidth;
                discPillEl.classList.add('price-flash');
                discNoteEl.style.display = 'none';
              } else {
                discPillEl.style.display = 'none';
                discNoteEl.textContent = p.note || '原价实付';
                discNoteEl.style.display = 'inline-block';
              }
            }

            // 更新折合月均（添加发光刷新动画）
            if (monthlyEl) {
              monthlyEl.textContent = p.monthlyAverage;
              monthlyEl.classList.remove('price-flash');
              void monthlyEl.offsetWidth;
              monthlyEl.classList.add('price-flash');
            }
          });
        });
      });

      // 2. 顶部快捷全表周期切换工具栏
      const toolbarButtons = document.querySelectorAll('.ppt-btn');
      toolbarButtons.forEach(tBtn => {
        tBtn.addEventListener('click', (e) => {
          e.preventDefault();
          toolbarButtons.forEach(b => b.classList.remove('is-active'));
          tBtn.classList.add('is-active');

          const filter = tBtn.getAttribute('data-period-filter') || 'default';

          rows.forEach(row => {
            const periodsDataStr = row.getAttribute('data-periods');
            if (!periodsDataStr) return;
            let periodsData = [];
            try {
              periodsData = JSON.parse(periodsDataStr);
            } catch (e) {
              return;
            }

            const pillButtons = Array.from(row.querySelectorAll('.period-pill-btn'));
            if (!pillButtons.length) return;

            let targetIdx = -1;
            if (filter === 'default') {
              // 优先选择月付，其次标准年付，其次其他年期，最后第0个
              targetIdx = periodsData.findIndex(p => p.period === '月付');
              if (targetIdx === -1) targetIdx = periodsData.findIndex(p => p.period === '年付');
              if (targetIdx === -1) targetIdx = periodsData.findIndex(p => p.period.includes('年') && !p.period.includes('半'));
              if (targetIdx === -1) targetIdx = 0;
            } else if (filter === '月付') {
              targetIdx = periodsData.findIndex(p => p.period === '月付');
              if (targetIdx === -1) targetIdx = periodsData.findIndex(p => p.period.includes('月') && !p.period.includes('半') && !p.period.includes('年'));
            } else if (filter === '季付') {
              targetIdx = periodsData.findIndex(p => p.period === '季付');
              if (targetIdx === -1) targetIdx = periodsData.findIndex(p => p.period.includes('季'));
            } else if (filter === '半年付') {
              // 半年付：精确匹配半年付或包含半年
              targetIdx = periodsData.findIndex(p => p.period === '半年付');
              if (targetIdx === -1) targetIdx = periodsData.findIndex(p => p.period.includes('半年'));
            } else if (filter === '年付') {
              // 年付特惠：优先精确匹配“年付”，若无则匹配含“年”但坚决排除“半年付”、“二年付”、“两年付”、“三年付”
              targetIdx = periodsData.findIndex(p => p.period === '年付');
              if (targetIdx === -1) {
                targetIdx = periodsData.findIndex(p => 
                  p.period.includes('年') && 
                  !p.period.includes('半') && 
                  !p.period.includes('二') && 
                  !p.period.includes('两') && 
                  !p.period.includes('三')
                );
              }
            } else if (filter === '两年付') {
              targetIdx = periodsData.findIndex(p => p.period.includes('两年') || p.period.includes('二年'));
            } else if (filter === '三年付') {
              targetIdx = periodsData.findIndex(p => p.period.includes('三年'));
            } else if (filter === '一次性') {
              targetIdx = periodsData.findIndex(p => p.period.includes('一次性') || p.period.includes('不限时'));
            } else {
              targetIdx = periodsData.findIndex(p => p.period === filter);
            }

            if (targetIdx !== -1 && pillButtons[targetIdx]) {
              pillButtons[targetIdx].click();
            }
          });
        });
      });
    }

    // 客户端多系统指南按键切换与全屏灯箱预览交互
    function initClientInteractiveGuide() {
      // 1. Tab 点击进入与切换
      const tabButtons = document.querySelectorAll('.cig-tab-btn');
      const panels = document.querySelectorAll('.cig-panel');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-platform-target');
          if (!targetId) return;

          tabButtons.forEach(b => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');

          panels.forEach(p => {
            if (p.id === `cig-panel-${targetId}`) {
              p.classList.add('is-active');
            } else {
              p.classList.remove('is-active');
            }
          });
        });
      });

      // 2. Lightbox 弹窗预览
      const modal = document.getElementById('tutorial-lightbox-modal');
      const backdrop = document.getElementById('lightbox-backdrop');
      const closeBtn = document.getElementById('lightbox-close');
      const lbImg = document.getElementById('lightbox-img');
      const lbTitle = document.getElementById('lightbox-title');
      const lbDesc = document.getElementById('lightbox-desc');

      if (!modal || !lbImg) return;

      function openLightbox(src, title, desc) {
        lbImg.src = src;
        if (lbTitle) lbTitle.textContent = title || '';
        if (lbDesc) lbDesc.textContent = desc || '';
        modal.classList.add('is-active');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        modal.classList.remove('is-active');
        document.body.style.overflow = '';
      }

      const imgWraps = document.querySelectorAll('.csc-img-wrap');
      imgWraps.forEach(wrap => {
        wrap.addEventListener('click', () => {
          const src = wrap.getAttribute('data-lightbox-src');
          const title = wrap.getAttribute('data-lightbox-title');
          const desc = wrap.getAttribute('data-lightbox-desc');
          if (src) openLightbox(src, title, desc);
        });
      });

      if (backdrop) backdrop.addEventListener('click', closeLightbox);
      if (closeBtn) closeBtn.addEventListener('click', closeLightbox);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-active')) {
          closeLightbox();
        }
      });
    }

    function initAll() {
      initCouponCopy();
      initScrollSpy();
      initMobileToc();
      initInteractivePricingTable();
      initClientInteractiveGuide();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  </script>
</BaseLayout>

