---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { allBrands } from '../../data/brands';
import { site } from '../../data/site';
import type { ReviewLatestTest } from '../../types/review';

const title = `梯子节点测速数据：下载速度、延迟与丢包记录 · ${site.name}`;
const description = `公开记录主推梯子品牌的节点测速数据，包括下载与上传速度、延迟、丢包率、Netflix与YouTube连接速度，并注明测试时间、环境与工具，附原始截图。目前已收录微风网络，其他品牌陆续补充。`;

// 测速数据与评测页同源：读取 src/content/reviews/*.md 里的 latestTest
const reviews = await getCollection('reviews');
const rows = allBrands
  .filter(b => b.category === 'primary')
  .map(b => {
    const data = reviews.find(r => r.data.slug === b.slug)?.data as { latestTest?: ReviewLatestTest; testStatus?: string } | undefined;
    const test = data?.latestTest;
    const metric = (label: string) => test?.metrics.find(m => m.label === label)?.value ?? '—';
    return { brand: b, test, metric, testStatus: data?.testStatus };
  });
const tested = rows.filter(r => r.test);
const latest = [...tested].sort((a, b) => b.test!.date.localeCompare(a.test!.date))[0];
---

<BaseLayout title={title} description={description}>
  <div class="container speedtest-data-page">
    <Breadcrumb items={[
      { label: '梯子推荐', href: '/tizi/' },
      { label: '品牌测评', href: '/reviews/' },
      { label: '梯子节点测速数据' }
    ]} />

    <header class="page-heading">
      <div class="telemetry-pill">
        <span class="pulse-indicator"></span>
        <span>NETWORK TESTS · 梯子节点测速记录</span>
      </div>
      <h1>梯子节点测速数据：速度、延迟与丢包记录</h1>
      <p>
        这里汇总 9 家主推梯子品牌的节点测速记录。每条记录都注明测试日期、节点、测试环境与所用工具，并附上原始截图，可以点进对应的测评页查看。目前已完成 {tested.length} / {rows.length} 家，其余品牌陆续补充。
      </p>
    </header>

    <!-- 顶部概览 -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <span class="kpi-label">已完成测速</span>
        <div class="kpi-num-row">
          <span class="kpi-num">{tested.length} / {rows.length}</span>
          <span class="kpi-unit">家</span>
        </div>
        <span class="kpi-sub">主推品牌测速进度</span>
      </div>
      {latest && (
        <>
          <div class="kpi-card">
            <span class="kpi-label">最新一次测试</span>
            <div class="kpi-num-row">
              <span class="kpi-num" style="font-size: 22px;">{latest.test!.date}</span>
            </div>
            <span class="kpi-sub">{latest.brand.name} · {latest.test!.node}</span>
          </div>
          <div class="kpi-card">
            <span class="kpi-label">下载 / 上传</span>
            <div class="kpi-num-row">
              <span class="kpi-num" style="font-size: 22px;">{latest.metric('下载速度')} / {latest.metric('上传速度')}</span>
            </div>
            <span class="kpi-sub">{latest.brand.name} · Cloudflare Speed Test</span>
          </div>
          <div class="kpi-card">
            <span class="kpi-label">延迟 / 丢包</span>
            <div class="kpi-num-row">
              <span class="kpi-num" style="font-size: 22px; color: #34d399;">{latest.metric('延迟')} / {latest.metric('丢包率')}</span>
            </div>
            <span class="kpi-sub">{latest.brand.name} · Cloudflare Speed Test</span>
          </div>
        </>
      )}
    </div>

    <!-- 测试方法说明 -->
    <div class="methodology-card">
      <div class="mc-header">
        <span class="icon">🔬</span>
        <strong>我们怎么测：多个工具交叉验证，并附上截图</strong>
      </div>
      <div class="mc-body">
        <div class="mc-column">
          <h4>1. 为什么用多个测速工具？</h4>
          <p>
            不同工具连接的测速服务器不同，结果会有差异。我们同时使用 <strong>Cloudflare Speed Test、Fast.com（Netflix 官方）、IPCheck.ing、YouTube 详细统计信息与 Whoer</strong>，分别看网速、连接 Netflix 与 YouTube 的实际速度、常用网站连通性，以及 IP 与 DNS 是否泄露。
          </p>
        </div>
        <div class="mc-column">
          <h4>2. 测速结果怎么看？</h4>
          <p>
            每条记录都写明测试日期与节点。<strong>每个人的实际速度与延迟会因所在地区、网络运营商和使用时段而不同</strong>，建议购买月付后按下方方法自行复测。
          </p>
        </div>
      </div>
      {latest && (
        <div class="mc-footer">
          <span>📍 最新测试环境：{latest.test!.environment} · 测试时间：{latest.test!.date}{latest.test!.time && ` ${latest.test!.time}`}</span>
        </div>
      )}
    </div>

    <!-- 测速记录表 -->
    <section class="section" style="padding-top: 20px;">
      <div class="section-heading">
        <div>
          <span class="eyebrow">SPEED TEST RECORDS</span>
          <h2>主推品牌节点测速记录</h2>
          <p class="muted">数值来源见每行备注，点击「查看截图」可在测评页看到原始测试截图。</p>
        </div>
      </div>

      <div class="table-container">
        <table class="telemetry-table">
          <thead>
            <tr>
              <th>品牌与测试节点</th>
              <th>测试日期</th>
              <th>下载 / 上传</th>
              <th>延迟 / 丢包</th>
              <th>Netflix（Fast.com）</th>
              <th>YouTube 连接速度</th>
              <th>测评与直达</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(({ brand, test, metric, testStatus }) => (
              <tr class:list={[{ 'row-pending': !test }]}>
                <td>
                  <div class="brand-cell">
                    <a href={`/reviews/${brand.slug}/`} class="bc-name">{brand.name}</a>
                    <span class="bc-node">{test ? test.node : brand.lineType}</span>
                  </div>
                </td>
                {test ? (
                  <>
                    <td><span class="time-cell">{test.date}</span></td>
                    <td><div class="isp-metric"><span class="isp-speed">↓ {metric('下载速度')}</span><span class="isp-ping">↑ {metric('上传速度')}</span></div></td>
                    <td><div class="isp-metric"><span class="isp-ping">{metric('延迟')}</span><span class="isp-loss">丢包 {metric('丢包率')}</span></div></td>
                    <td><strong class="ytb-speed">{metric('Netflix 测速')}</strong></td>
                    <td><strong class="ytb-speed">{metric('YouTube 连接速度')}</strong></td>
                  </>
                ) : (
                  <td colspan="5"><span class="pending-text">{testStatus ?? '待测试 · 测速数据陆续补充'}</span></td>
                )}
                <td>
                  <div class="action-cell">
                    <a href={test ? `/reviews/${brand.slug}/#module-experience` : `/reviews/${brand.slug}/`} class="btn-table review">{test ? '查看截图' : '测评'}</a>
                    <a href={`/go/${brand.slug}/`} target="_blank" rel="nofollow noopener sponsored" class="btn-table go">官网 ↗</a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {latest && <p class="table-note">下载、上传、延迟、丢包来自 Cloudflare Speed Test；Netflix 一栏来自 Fast.com；YouTube 一栏来自 YouTube 详细统计信息。</p>}
    </section>

    <!-- 底部自测指南 -->
    <div class="self-test-guide">
      <span class="eyebrow">DIY SPEEDTEST GUIDE</span>
      <h3>如何在自己的电脑上进行客观真实测速？</h3>
      <p>
        由于每位用户的所在地宽带运营商品质与本地路由器差异巨大，我们强烈建议您在购买月付套餐后，按照以下三步自行复测：
      </p>
      <div class="diy-steps-grid">
        <div class="diy-card">
          <div class="diy-num">01</div>
          <div class="diy-title">锁定晚高峰 20:30 测试</div>
          <div class="diy-desc">避开白天的空闲时段，在晚上网络负载最繁重时进行测试，才能看清该机场的真实抗拥堵底色。</div>
        </div>
        <div class="diy-card">
          <div class="diy-num">02</div>
          <div class="diy-title">打开 YouTube 统计信息</div>
          <div class="diy-desc">在播放画面上右键点击【详细统计信息 (Stats for nerds)】，观察 Connection Speed：1080p 一般需要稳定 10,000 Kbps 以上，4K 需要更高。</div>
        </div>
        <div class="diy-card">
          <div class="diy-num">03</div>
          <div class="diy-title">用 Cloudflare 与 Fast.com 测速</div>
          <div class="diy-desc">打开 speed.cloudflare.com 和 fast.com 各测一次，对比下载、上传、延迟与丢包；若频繁出现丢包或延迟大幅跳动，说明线路不稳定。</div>
        </div>
      </div>

      <div class="guide-actions">
        <a href="/tizi/" class="button primary">查看梯子推荐与选购指南 ↗</a>
        <a href="/reviews/" class="button secondary">返回全部品牌深度测评目录 →</a>
      </div>
    </div>
  </div>
</BaseLayout>


<style>
  .speedtest-data-page {
    padding-bottom: 70px;
  }

  .telemetry-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #34d399;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: 0.05em;
  }

  .pulse-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 10px #10b981;
  }

  /* 顶部四大 KPI 卡片 */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin: 28px 0;
  }

  .kpi-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    backdrop-filter: blur(8px);
  }

  .kpi-label {
    font-size: 12px;
    color: #94a3b8;
  }

  .kpi-num-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 4px 0;
  }

  .kpi-num {
    font-size: 26px;
    font-weight: 800;
    color: #ffffff;
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
  }

  .kpi-unit {
    font-size: 13px;
    color: var(--gold);
    font-weight: 600;
  }

  .kpi-sub {
    font-size: 11px;
    color: #64748b;
  }

  /* 方法论卡片 */
  .methodology-card {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-left: 4px solid #3b82f6;
    border-radius: 12px;
    padding: 24px;
    margin: 30px 0;
  }

  .mc-header {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .mc-body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .mc-column h4 {
    font-size: 14px;
    color: #93c5fd;
    margin-bottom: 8px;
  }

  .mc-column p {
    font-size: 13px;
    color: #cbd5e1;
    line-height: 1.7;
    margin: 0;
  }

  .mc-footer {
    margin-top: 18px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 11px;
    color: #64748b;
  }

  /* 筛选按钮 */
  .filter-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .f-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .f-pill:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .f-pill.active {
    background: var(--gold);
    color: #000000;
    border-color: var(--gold);
  }

  /* 表格样式 */
  .table-container {
    overflow-x: auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    margin-top: 18px;
  }

  .telemetry-table {
    width: 100%;
    min-width: 950px;
    border-collapse: collapse;
    font-size: 13px;
  }

  .telemetry-table th {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    padding: 14px 16px;
    text-align: left;
    font-weight: 700;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .telemetry-table td {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    vertical-align: middle;
  }

  .telemetry-table tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .brand-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bc-name {
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
  }

  .bc-name:hover {
    color: var(--gold);
  }

  .bc-node {
    font-size: 11px;
    color: #94a3b8;
  }

  .badge-line {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
    font-size: 11px;
    font-weight: 600;
  }

  .time-cell {
    font-size: 11px;
    color: #64748b;
  }

  .isp-metric {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 11px;
  }

  .isp-ping {
    color: #ffffff;
    font-weight: 700;
  }

  .isp-loss {
    color: #34d399;
  }

  .isp-speed {
    color: #93c5fd;
  }

  .ytb-metric {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ytb-speed {
    color: var(--gold);
    font-size: 13px;
  }

  .ytb-status {
    font-size: 11px;
    color: #34d399;
  }

  .action-cell {
    display: flex;
    gap: 6px;
  }

  .btn-table {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-table.review {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .btn-table.review:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .btn-table.go {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #ffffff;
  }

  .btn-table.go:hover {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
  }

  /* 自测指南板块 */
  .self-test-guide {
    background: #11141c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 32px;
    margin-top: 50px;
  }

  .self-test-guide h3 {
    font-size: 18px;
    color: #ffffff;
    margin: 8px 0 10px;
  }

  .self-test-guide p {
    font-size: 13px;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .diy-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
  }

  .diy-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 18px;
  }

  .diy-num {
    font-family: monospace;
    font-size: 18px;
    font-weight: 800;
    color: var(--gold);
    margin-bottom: 8px;
  }

  .diy-title {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .diy-desc {
    font-size: 12px;
    color: #94a3b8;
    line-height: 1.6;
  }

  .guide-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .row-pending td { opacity: 0.7; }
  .pending-text { font-size: 12.5px; color: #94a3b8; }
  .table-note { margin-top: 10px; font-size: 12px; color: #94a3b8; }
</style>
