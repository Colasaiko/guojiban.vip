  .cig-tab-btn.is-active .cig-tab-name {
    color: #93c5fd;
  }

  .cig-tab-badge {
    font-size: 11px;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.06);
    padding: 1px 6px;
    border-radius: 4px;
    align-self: flex-start;
  }

  .cig-tab-btn.is-active .cig-tab-badge {
    background: rgba(37, 99, 235, 0.35);
    color: #bfdbfe;
  }

  /* 面板展示 */
  .cig-panel {
    display: none;
    animation: cigFadeIn 0.25s ease-out;
  }

  .cig-panel.is-active {
    display: block;
  }

  @keyframes cigFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cig-panel-intro {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 18px;
  }

  .cpi-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .cpi-platform-badge {
    font-size: 13px;
    font-weight: 700;
    color: #60a5fa;
    background: rgba(96, 165, 250, 0.12);
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid rgba(96, 165, 250, 0.25);
