---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FAQ from '../components/FAQ.astro';
import { categories, categoryHref, site } from '../data/site';
const posts = await getCollection('blog', ({data}) => !data.draft);
---
<BaseLayout title={`${site.name} · 国外好用App推荐与海外AI工具使用指南`}><div class="container">
<section class="hero"><div class="hero-copy"><span class="pill"><span class="status-dot"></span> 国外好用App · 海外热门AI工具 · 中文使用指南</span><h1>想要国外好用的 App 与 AI 神器？<br />上国际版VIP，<span class="hero-emphasis">海外优质软件一站搞定。</span></h1><p>许多国外主流 App 与前沿 AI 工具在国内无法直接访问？<br />国际版VIP 专为解决国内使用难点而生，精选 ChatGPT、Claude 等海外热门 AI 及高口碑应用，<br class="desktop-break" />提供清晰的使用指南、平台差异与入门常识，让你身在国内也能轻松畅享世界级优质资源。</p><div class="hero-actions"><a class="button primary" href="/blog/">发现海外好用工具 <span>↗</span></a><a class="button secondary" href="#categories">按场景找 App / AI <span>↓</span></a></div><div class="hero-footnote"><span>国外好用 App 推荐</span><i></i><span>海外热门 AI 工具</span><i></i><span>国内使用与账号常识</span></div></div>
<div class="explore-board"><div class="board-top"><span><span class="status-dot"></span> DISCOVERY BOARD</span><span>01 / 海外资源雷达</span></div><div class="board-globe"><div class="globe"><div class="globe-longitude"></div><div class="globe-latitude"></div><span>↗</span></div><span class="float-label label-one">◎ 国外社媒 App</span><span class="float-label label-two">✳ 海外热门 AI</span><span class="float-label label-three">▷ 海外影音流媒体</span></div><div class="board-bottom"><div><small>GLOBAL APPS & AI</small><strong>国外好用的软件与前沿 AI，从这里开启。</strong></div><a href="/topics/" aria-label="探索内容专题">↗</a></div></div></section>
<div class="info-strip"><div><strong>06</strong><span>内容场景分类</span></div><div><strong>Web + App</strong><span>覆盖不同使用平台</span></div><div><strong>中文指南</strong><span>让信息更容易理解</span></div><div><strong class="small-stat">正在搭建</strong><span>条目内容将逐步补充</span></div></div>
<section id="categories" class="section"><div class="section-heading"><div><span class="eyebrow">EXPLORE BY INTEREST</span><h2>从你的兴趣出发</h2><p class="muted">不必漫无目的，从一个熟悉的场景开始。</p></div><span class="section-index">01 — 分类探索</span></div><div class="category-grid">{categories.map((category, i) => <a class="category-card" href={categoryHref(category.slug)}><div class="category-top"><span class="category-icon">{category.icon}</span><span class="category-number">0{i+1}</span></div><h3>{category.name}<span>↗</span></h3><p>{category.description}</p></a>)}</div></section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">THE READING ROOM</span><h2>值得开始的阅读</h2><p class="muted">先了解，再选择。这里是未来内容的起点。</p></div><a class="text-link" href="/blog/">全部文章 ↗</a></div><div class="editorial-grid">{posts.slice(0,1).map(post => <ArticleCard post={post} />)}<div class="up-next"><span class="eyebrow">ON THE HORIZON</span><h3>更多内容，<br />正在路上。</h3><p>接下来，我们将逐步补齐这些内容方向。</p><div class="up-next-row"><span>01</span><div><strong>网站与 App 介绍</strong><small>用途、场景与使用条件</small></div><span>待更新</span></div><div class="up-next-row"><span>02</span><div><strong>平台差异与对比</strong><small>网页端、移动端与设备支持</small></div><span>待更新</span></div><div class="up-next-row"><span>03</span><div><strong>访问情况与常见问题</strong><small>核实时间、环境与来源说明</small></div><span>待更新</span></div></div></div></section>
<section class="topic-banner"><div><span class="eyebrow">A LITTLE GUIDANCE</span><h2>第一次探索？<br />从一份入门指南开始。</h2><p>把零散的信息连成线，建立属于自己的认知地图。</p><a class="button light" href="/topics/download-overseas-apps/">国外 App 下载指南 ↗</a></div><div class="topic-steps"><div><span>01</span><strong>认识用途</strong><small>它能帮你完成什么</small></div><div><span>02</span><strong>了解差异</strong><small>不同平台，如何选择</small></div><div><span>03</span><strong>做好准备</strong><small>提前了解使用条件</small></div></div></section>
<FAQ /><section class="closing"><span class="eyebrow">STAY CURIOUS</span><h2>世界很大，从这里打开一页。</h2><a class="text-link" href="/blog/">发现你的下一篇阅读 ↗</a></section>
</div></BaseLayout>
