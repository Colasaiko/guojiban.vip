  <script is:inline>
    (function () {
      var modal = document.getElementById('free-node-modal');
      var confirmBtn = document.getElementById('free-node-confirm');
      var pending = null;

      function closeModal() { if (modal) { modal.style.display = 'none'; document.body.style.overflow = ''; } pending = null; }
      // 旧式复制：剪贴板 API 不可用或被浏览器拒绝时使用
      function legacyCopy(text) {
        try {
          var ta = document.createElement('textarea');
          ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.left = '-9999px';
          document.body.appendChild(ta); ta.select();
          var ok = document.execCommand('copy');
          document.body.removeChild(ta);
          return ok;
        } catch (e) { return false; }
      }
      // 返回是否复制成功；失败时由调用方显示链接让读者手动复制
      function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) {
          return navigator.clipboard.writeText(text).then(function () { return true; }, function () { return legacyCopy(text); });
        }
        return Promise.resolve(legacyCopy(text));
      }

      document.querySelectorAll('.unlock-action-area').forEach(function (area) {
        var btn = area.querySelector('.unlock-node-btn');
        if (!btn) return;
        btn.addEventListener('click', function () {
          pending = area;
          if (modal) { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
        });
      });

      if (confirmBtn) confirmBtn.addEventListener('click', function () {
        var area = pending;
        closeModal();
        if (!area) return;
        copyText(area.dataset.url).then(function (ok) {
          var tip = area.querySelector('.copy-success-tip');
          var text = area.querySelector('.btn-text');
          if (tip) {
            tip.style.display = 'block';
            if (!ok) {
              // 浏览器不允许自动复制时，直接显示链接供手动复制
              var strong = tip.querySelector('strong');
              if (strong) strong.textContent = '请手动复制下面的订阅链接：';
              var code = tip.querySelector('.manual-url') || document.createElement('code');
              code.className = 'manual-url';
              code.textContent = area.dataset.url;
              code.style.cssText = 'display:block;word-break:break-all;margin:6px 0;user-select:all;';
              if (!code.parentNode) tip.insertBefore(code, strong.nextSibling);
            }
          }
          if (text) text.textContent = ok ? '已复制，点击可再次复制' : '点击可再次尝试复制';
        });
      });

      if (modal) {
        modal.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', closeModal); });
        modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
      }
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

      // 最近更新：读取 GitHub 提交记录，显示为北京时间
      document.querySelectorAll('[data-last-updated]').forEach(function (el) {
        var api = 'https://api.github.com/repos/' + el.dataset.repo + '/commits?path=' + encodeURIComponent(el.dataset.path) + '&per_page=1';
        fetch(api, { headers: { Accept: 'application/vnd.github+json' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (commits) {
            var iso = commits && commits[0] && commits[0].commit && commits[0].commit.committer && commits[0].commit.committer.date;
            if (!iso) return;
            var s = new Date(iso).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }).replace(/\//g, '-');
            el.textContent = s + '（北京时间）';
          })
          .catch(function () {});
      });
    })();
  </script>
