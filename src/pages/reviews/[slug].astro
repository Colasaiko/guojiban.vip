    max-height: 70vh;
    object-fit: contain;
  }

  .lightbox-caption {
    padding: 14px 20px;
    background: #0f172a;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .lightbox-caption strong {
    display: block;
    font-size: 14px;
    color: #60a5fa;
    margin-bottom: 4px;
  }

  .lightbox-caption p {
    font-size: 12.5px;
    color: #cbd5e1;
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .cig-platform-tabs {
      grid-template-columns: repeat(2, 1fr);
