---
import { allBrands } from '../../data/brands';
import { site } from '../../data/site';

export function getStaticPaths() {
  return allBrands.map(brand => ({
    params: { slug: brand.slug },
    props: { brand }
  }));
}

const { brand } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>即将前往第三方品牌网站 · {brand.name} | {site.name}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    :root {
      --bg: #07090e;
      --card-bg: rgba(14, 20, 32, 0.95);
      --border: rgba(40, 56, 85, 0.7);
      --text: #f0f4fc;
      --muted: #8b9bb4;
      --gold: #f59e0b;
      --blue: #3b82f6;
      --blue-glow: rgba(59, 130, 246, 0.35);
      --green: #10b981;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      background-image: 
        radial-gradient(ellipse at 50% 20%, rgba(59, 130, 246, 0.12) 0%, transparent 60%),
        radial-gradient(circle at 80% 80%, rgba(245, 158, 11, 0.06) 0%, transparent 40%);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 24px 16px;
      overflow-x: hidden;
    }

    .redirect-card {
      width: 100%;
      max-width: 530px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 38px 30px;
      text-align: center;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 40px var(--blue-glow);
      backdrop-filter: blur(16px);
      position: relative;
    }

    /* 顶部网关标识 */
    .gateway-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 14px;
      border-radius: 999px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: var(--green);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.05em;
      margin-bottom: 22px;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background-color: var(--green);
      border-radius: 50%;
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* 品牌图标与官方认证标记 */
    .brand-avatar-wrap {
      margin: 4px auto 18px;
      position: relative;
      width: 72px;
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .brand-avatar {
      width: 72px;
      height: 72px;
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.22), rgba(14, 165, 233, 0.12));
      border: 1px solid rgba(56, 189, 248, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 25px rgba(56, 189, 248, 0.25);
    }

    .brand-initial {
      font-size: 30px;
      font-weight: 800;
      color: #38bdf8;
      letter-spacing: -0.02em;
    }

    .verified-check {
      position: absolute;
      bottom: -2px;
      right: -2px;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #10b981;
      color: #ffffff;
      font-size: 12px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #0e1420;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    }

    h1 {
      font-size: 21px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 12px;
      line-height: 1.4;
    }

    .depart-notice {
      font-size: 15px;
      color: #e2e8f0;
      line-height: 1.6;
      margin-bottom: 16px;
    }

    .target-brand {
      color: var(--gold);
      font-weight: 700;
    }

    /* 推广声明卡片 */
    .disclosure-box {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 13px 16px;
      margin-bottom: 14px;
      text-align: left;
    }

    .disclosure-box p {
      font-size: 12.5px;
      line-height: 1.7;
      color: #94a3b8;
    }

    .disclosure-box strong {
      color: #fbbf24;
    }

    .terms-notice {
      font-size: 13px;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    /* 优惠券提示卡 */
    .coupon-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(245, 158, 11, 0.1);
      border: 1px dashed rgba(245, 158, 11, 0.45);
      padding: 9px 16px;
      border-radius: 12px;
      margin-bottom: 20px;
      font-size: 13px;
      color: var(--gold);
      flex-wrap: wrap;
      justify-content: center;
    }

    .coupon-code {
      font-family: monospace;
      font-size: 14px;
      font-weight: 700;
      color: #ffffff;
      background: rgba(0, 0, 0, 0.45);
      padding: 2px 8px;
      border-radius: 6px;
      letter-spacing: 0.08em;
    }

    /* 操作按钮 */
    .actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .button-primary {
      display: block;
      width: 100%;
      padding: 14px 22px;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: #ffffff;
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
      border-radius: 12px;
      transition: all 0.25s ease;
      box-shadow: 0 4px 18px rgba(37, 99, 235, 0.4);
      border: none;
      cursor: pointer;
    }

    .button-primary:hover {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      transform: translateY(-1px);
      box-shadow: 0 6px 24px rgba(37, 99, 235, 0.55);
    }

    .user-decision-note {
      font-size: 12px;
      font-style: italic;
      color: #64748b;
      margin-top: 4px;
      margin-bottom: 4px;
    }

    .button-secondary {
      display: inline-block;
      padding: 8px;
      background: transparent;
      color: var(--muted);
      font-size: 13px;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: color 0.2s ease;
    }

    .button-secondary:hover {
      color: #ffffff;
    }

    /* 底部安全说明 */
    .security-footer {
      margin-top: 22px;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 11px;
      color: #5c6b84;
      line-height: 1.6;
    }

    .site-brand {
      margin-top: 20px;
      font-size: 12px;
      color: #4b5870;
      letter-spacing: 0.05em;
    }

    .site-brand a {
      color: var(--muted);
      text-decoration: none;
    }

    .site-brand a:hover {
      color: #ffffff;
    }
  </style>
</head>
<body>
  <div class="redirect-card">
    <div class="gateway-badge">
      <span class="pulse-dot"></span>
      <span>外链跳转提示 · 自主访问</span>
    </div>

    <!-- 品牌头像与官方认证徽章 -->
    <div class="brand-avatar-wrap">
      <div class="brand-avatar">
        <span class="brand-initial">{brand.name.slice(0, 1)}</span>
      </div>
      <span class="verified-check" title="官方核验">✓</span>
    </div>

    <h1>即将前往第三方品牌网站</h1>

    <p class="depart-notice">
      您即将离开{site.name}，前往 <strong class="target-brand">{brand.name}</strong> 网站。
    </p>

    <div class="disclosure-box">
      <p>
        <strong>推广声明：</strong> 本页面可能包含联盟推广链接。如果您通过此链接购买服务，{site.name}可能获得一定佣金，通常不会因此增加您的购买价格。
      </p>
    </div>

    <p class="terms-notice">
      本站仅提供品牌介绍与信息参考，实际套餐、优惠及服务条款请以品牌官网为准。
    </p>

    <!-- 优惠券展示（若有） -->
    {brand.coupon && brand.coupon !== '无需优惠码' ? (
      <div class="coupon-pill">
        <span>🎁 专属优惠券：</span>
        <span class="coupon-code">{brand.coupon}</span>
        <span>（{brand.couponDiscount}）</span>
      </div>
    ) : null}

    <div class="actions">
      <a
        id="jump-btn"
        href={brand.targetUrl}
        rel="noopener noreferrer nofollow sponsored"
        class="button-primary"
      >
        自行点击：前往品牌官网 ↗
      </a>

      <p class="user-decision-note">
        本站不会自动跳转，是否继续访问由您自行决定。
      </p>

      <button type="button" onclick="history.back()" class="button-secondary">
        ← 取消并返回上一页
      </button>
    </div>

    <div class="security-footer">
      🛡️ 安全声明：本页面为{site.name}对外跳转网关（Link Cloaking），已严格通过防钓鱼与域名白名单核验。未经过您的授权不会收集任何隐私。
    </div>
  </div>

  <div class="site-brand">
    <a href="/">{site.name}</a> · 权威客观的海外网络资源与梯子工具导航
  </div>

  <script>
    // 自动将优惠码写入剪贴板，方便用户在结账页面直接粘贴
    const couponCode = document.querySelector('.coupon-code');
    if (couponCode && navigator.clipboard) {
      navigator.clipboard.writeText(couponCode.textContent.trim()).catch(() => {});
    }
  </script>
</body>
</html>
