// 每张卡片底部的「本站测试」：与评测页同源，读取品牌 md 的 latestTest / testStatus
// 免费公开节点（GitHub 开源项目），供读者与主推品牌对比体验
const testNodes = freeNodeSources;
// 「最近更新」：构建时先读一次 GitHub 提交时间（北京时间），页面打开后脚本会再刷新为最新
const fmtBeijing = (iso: string) => new Date(iso).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }).replace(/\//g, '-');
const lastUpdated = Object.fromEntries(await Promise.all(Object.entries(testNodes).map(async ([k, s]) => {
  const iso = await fetchLastUpdated(s);
  return [k, iso ? fmtBeijing(iso) : null];
}))) as Record<keyof typeof testNodes, string | null>;

const reviewData = Object.fromEntries((await getCollection('reviews')).map(r => [r.data.slug, r.data as unknown as BrandReviewDetail]));
const testLine = Object.fromEntries(Object.keys(brands).map(slug => {
  const d = reviewData[slug];
  const s = testSummary(d?.latestTest);
  const text = s.tested
    ? `${s.date} ${s.node}（非晚高峰）：下载 ${s.speed}、延迟 ${s.latency}${s.packetLoss ? `、丢包 ${s.packetLoss}` : ''}`
    : (d?.testStatus ? '与官方洽谈中，测试账号到位后补充测速数据' : '待测试');
  return [slug, text];
})) as Record<keyof typeof brands, string>;

---
<BaseLayout
