---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { allBrands } from '../../data/brands';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import SpeedTestReportCard from '../../components/SpeedTestReportCard.astro';
import { testSummary } from '../../utils/latestTest';
import type { BrandReviewDetail } from '../../types/review';

const reviewsDetailMap = Object.fromEntries((await getCollection('reviews')).map(r => [r.data.slug, r.data as unknown as BrandReviewDetail]));

const primaryBrands = allBrands.filter(b => b.category === 'primary');

const auditCriteria = [
  { icon: '⏱️', title: '速度、延迟与丢包', desc: '用 Cloudflare Speed Test、Fast.com 等工具记录下载、上传、延迟与丢包，注明测试日期、节点与网络环境；晚高峰测试会陆续补充。' },
  { icon: '🤖', title: '海外 AI 与网站连通', desc: '用 IPCheck.ing 检测 ChatGPT、Claude、Gemini 等 50 多个网站能否访问，并记录各自的响应延迟。' },
  { icon: '🎬', title: '流媒体与 IP 检测', desc: '记录 YouTube 播放分辨率与连接速度、Fast.com（Netflix）测速，并用 Whoer 检查出口 IP 归属、DNS 泄露与黑名单。' },
  { icon: '🛡️', title: '退款机制与工单响应', desc: '整理官网公开的退款条款、客服与工单渠道、官方公告频道，方便你购买前了解售后规则。' }
];
---
<BaseLayout
  title={`9大主推梯子品牌测评：套餐价格、优惠码与优缺点 · ${site.name}`}
  description="国际版VIP 主推梯子品牌测评：微风网络、飞猫云、暮光加速、大佬云、萤火虫、灵猫、闪跃、无忧链接、跨界云，逐家整理套餐价格、优惠码、客户端使用方法、优缺点与常见问题，测速数据持续补充中。"
>
  <div class="container">
    <Breadcrumb items={[{ label: '梯子推荐', href: '/tizi/' }, { label: '品牌测评' }]} />

    <header class="page-heading">
      <span class="eyebrow">IN-DEPTH BENCHMARK & REVIEWS · 全部品牌测评中心</span>
      <h1>9大主推梯子品牌测评：套餐、优惠码与使用方法</h1>
      <p>面对市面上形形色色的梯子服务商，究竟谁的专线更靠谱？国际版VIP 按统一框架整理每个品牌的套餐、线路与官方资料，并逐家补充测速截图，每次测试都注明日期、节点与网络环境。点击任意品牌卡片中的<strong>“阅读详细测评文章”</strong>，即可进入查看该品牌的专线质量、测速跑分、真实优缺点与避坑指引。</p>
    </header>

    <!-- 站长中立声明与月付提示 -->
    <div class="aff-tip-card" style="margin-bottom: 35px;">
      <span class="aff-tip-badge">⚖️ 测评中立声明与选购提醒</span>
      <div class="aff-tip-body">
        <strong>测试数据说明与核心原则</strong>
        <p>评测内容根据官方资料整理；已完成测速的品牌附有测试截图，目前的测试为家庭宽带、非晚高峰时段，每个人的实际速度与延迟会因所在地区、网络运营商和使用时段而不同。<strong>请牢记站长核心原则：无论测评文章得分多高，购买时请务必先尝试一个月月付套餐！</strong>在您自己的本地网络测试满意后，再考虑长期续费，切勿盲目直接购买一年。</p>
      </div>
    </div>

    <!-- 测评标准四重维度 -->
    <section class="section" style="padding-top: 10px; padding-bottom: 35px;">
      <div class="section-heading">
        <div>
          <span class="eyebrow">AUDIT METHODOLOGY</span>
          <h2>测评的四大考核维度</h2>
          <p class="muted">每项结果都附截图和测试环境，没测过的项目标注「待测试」。</p>
        </div>
      </div>

      <div class="guidance-grid">
        {auditCriteria.map(item => (
          <div class="guidance-card">
            <span style="font-size: 26px; display: block; margin-bottom: 10px;">{item.icon}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 站长核心主推品牌测评文章专区 -->
    <section class="section" style="padding-top: 10px; padding-bottom: 35px;">
      <div class="section-heading">
        <div>
          <span class="eyebrow">FEATURED REVIEWS</span>
          <h2>站长核心主推品牌测评（TOP 09）</h2>
          <p class="muted">站长主推的 9 个品牌，点击可进入查看完整测评文章与已有的测速记录。</p>
        </div>
        <span class="section-index">09 BRANDS</span>
      </div>

      <div class="reviews-list">
        {primaryBrands.map((b, idx) => (
          <article class="review-card">
            <!-- 顶部头信息 -->
            <div class="review-card-top">
              <div class="review-brand-meta">
                <span class="review-badge-num">{idx + 1 < 10 ? `0${idx + 1}` : idx + 1}</span>
                <div class="review-brand-title">
                  <h3>
                    <a href={`/reviews/${b.slug}/`} style="color: #ffffff; text-decoration: none;">
                      {b.name}
                    </a>
                    <span class="bp-tag" style="font-size: 11px;">{b.couponDiscount}</span>
                  </h3>
                  <span class="review-tag-line">{reviewsDetailMap[b.slug]?.subtitle || b.tag}</span>
                </div>
              </div>

              <div class="review-score-box">
                <div>
                  <span class="rs-label">骨干架构</span>
                  <div style="display: flex; align-items: baseline; gap: 4px;">
                    <span class="rs-num" style="font-size: 16px; color: #60a5fa;">{b.lineType}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- 核心规格指标 -->
            <div class="review-metrics-grid">
              <div class="rm-item">
                <span class="rm-label">最低套餐起步</span>
                <span class="rm-value" style="color: #60a5fa;">🏷️ {b.minMonthly}</span>
              </div>
              <div class="rm-item">
                <span class="rm-label">骨干线路架构</span>
                <span class="rm-value">🌐 {b.lineType}</span>
              </div>
              <div class="rm-item">
                <span class="rm-label">实测下载（非晚高峰）</span>
                <span class="rm-value">⚡ {testSummary(reviewsDetailMap[b.slug]?.latestTest).speed}</span>
              </div>
              <div class="rm-item">
                <span class="rm-label">实测延迟（非晚高峰）</span>
                <span class="rm-value">📶 {testSummary(reviewsDetailMap[b.slug]?.latestTest).latency}</span>
              </div>
            </div>

            <!-- 使用方式专属提示条 -->
            <div style="background: rgba(245, 158, 11, 0.06); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 8px; padding: 8px 12px; margin-bottom: 14px; font-size: 12px; color: #fef08a;">
              📲 <strong>使用方式：</strong>{
                b.slug === 'weifeng'
                  ? '官方专属客户端，iOS 采用 Nextin 识别码接入（不提供明文通用订阅链接）'
                  : b.slug === 'wuyou'
                  ? 'iOS / Android / Windows / macOS 四平台官方自研客户端，一键登录即用'
                  : b.slug === 'firefly'
                  ? '官方专属客户端与通用订阅导入，全平台自研协议深度优化'
                  : b.slug === 'dalao'
                  ? '官方专属免配置客户端，同时支持 Shadowsocks 协议订阅导入'
                  : '官方专属客户端，下载登录即用 / 支持多端通用标准订阅导入'
              }
            </div>

            <!-- 专属测评大标题与简评 -->
            <h4 style="font-size: 14px; font-weight: 700; color: #60a5fa; margin-bottom: 8px;">
              <a href={`/reviews/${b.slug}/`} style="color: inherit; text-decoration: none;">
                {reviewsDetailMap[b.slug]?.h1 || `${b.name}深度测评`}
              </a>
            </h4>
            <p class="review-body" style="margin-bottom: 16px;">
              {b.summary}
            </p>

            <!-- 06 测速与节点响应报告（与测评文章第 06 章节同源） -->
            <SpeedTestReportCard brandSlug={b.slug} titleSuffix="节点延迟测试" />

            <!-- 底部操作栏 -->
            <div class="review-bottom-bar">
              <div class="review-coupon-area" style="display: flex; align-items: center; gap: 6px;">
                <span>专属折扣：</span>
                <code style="background: rgba(255, 255, 255, 0.1); color: #fff; padding: 2px 6px; border-radius: 4px;">{b.coupon}</code>
                {b.coupon !== '无需优惠码' && (
                  <button
                    type="button"
                    class="mini-copy-btn list-copy-btn"
                    data-code={b.coupon}
                    title="点击复制优惠码"
                    style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.18); color: #cbd5e1; font-size: 11px; padding: 2px 7px; border-radius: 4px; cursor: pointer;"
                  >
                    复制 📋
                  </button>
                )}
                <span style="font-size: 11px; color: #fcd34d; font-weight: 600;">（{b.couponDiscount}）</span>
              </div>

              <div class="review-actions">
                <a
                  href={`/reviews/${b.slug}/`}
                  class="button primary"
                  style="font-size: 13px; font-weight: 700; padding: 10px 18px;"
                >
                  阅读详细测评文章 →
                </a>
                <a
                  href={`/go/${b.slug}/`}
                  target="_blank"
                  rel="nofollow noopener noreferrer sponsored"
                  class="button secondary"
                  style="font-size: 13px; padding: 10px 16px;"
                >
                  前往官网 ↗
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 底部收尾引导 -->
    <section class="closing">
      <span class="eyebrow">NEED RECOMMENDATIONS?</span>
      <h2>想看专线与免费节点的对比？</h2>
      <p class="muted" style="margin-top: 10px; font-size: 13px;">前往梯子推荐专题页，查看主推品牌与免费公开节点的差别，以及为什么不建议长期使用免费节点。</p>
      <div style="margin-top: 25px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/tizi/" class="button primary">前往【梯子推荐】专题页面 ↗</a>
        <a href="/brands/" class="button secondary">浏览完整【梯子品牌库】档案 →</a>
      </div>
    </section>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const copyBtns = document.querySelectorAll('.list-copy-btn');
      copyBtns.forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          const code = btn.getAttribute('data-code');
          if (!code || code === '无需优惠码') return;

          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(code);
            } else {
              const ta = document.createElement('textarea');
              ta.value = code;
              ta.style.position = 'fixed';
              ta.style.left = '-9999px';
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }

            const originalText = btn.textContent;
            btn.textContent = '已复制 ✓';
            btn.style.color = '#6ee7b7';
            setTimeout(() => {
              btn.textContent = originalText;
              btn.style.color = '';
            }, 2000);
          } catch (err) {
            console.error('复制失败:', err);
          }
        });
      });
    });
  </script>
</BaseLayout>
