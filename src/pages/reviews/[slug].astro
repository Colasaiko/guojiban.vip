  }

  .cpi-notice-banner {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.12) 0%, rgba(15, 23, 42, 0.8) 100%);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-left: 4px solid #f59e0b;
    border-radius: 8px;
    padding: 10px 14px;
    margin-top: 12px;
  }

  .cnb-icon {
    font-size: 16px;
    line-height: 1.3;
    flex-shrink: 0;
  }

  .cnb-text {
    font-size: 12px;
    color: #fef08a;
    line-height: 1.6;
  }

  .cnb-text strong {
    color: #ffffff;
    margin-right: 4px;
  }

  /* 步骤卡片网格 */
  .cig-steps-grid {
    display: grid;
    gap: 14px;
  }

  .grid-windows {
    grid-template-columns: repeat(3, 1fr);
  }

  .grid-macos {
    grid-template-columns: repeat(4, 1fr);
  }

  .grid-android {
    grid-template-columns: repeat(4, 1fr);
  }

  .grid-ios {
    grid-template-columns: repeat(3, 1fr);
  }

  .cig-step-card {
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .cig-step-card:hover {
    transform: translateY(-2px);
    border-color: rgba(96, 165, 250, 0.4);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }

  .csc-img-wrap {
    position: relative;
    background: #000000;
    cursor: zoom-in;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 竖屏手机截图比例适配 */
  .grid-android .csc-img-wrap,
  .grid-ios .csc-img-wrap {
    aspect-ratio: 9 / 16;
  }

  .csc-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.3s ease;
  }

  .cig-step-card:hover .csc-img-wrap img {
    transform: scale(1.04);
  }

  .csc-step-tag {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(0, 0, 0, 0.75);
    color: #60a5fa;
    border: 1px solid rgba(96, 165, 250, 0.4);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .csc-zoom-hint {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
    backdrop-filter: blur(2px);
  }

  .csc-zoom-hint span {
    font-size: 11.5px;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.8);
