---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { allBrands, type BrandInfo } from '../../data/brands';
import { getCollection } from 'astro:content';
import type { BrandReviewDetail } from '../../types/review';
import { site } from '../../data/site';
import { brandSpeedTestMap } from '../../data/brandSpeedTests';
import SpeedTestReportCard from '../../components/SpeedTestReportCard.astro';
import { testSummary } from '../../utils/latestTest';

export async function getStaticPaths() {
  // 每个 src/content/reviews/*.md 生成一个测评页
  const reviews = await getCollection('reviews');
  return reviews.flatMap(entry => {
    const brand = allBrands.find(b => b.slug === entry.data.slug);
    return brand ? [{ params: { slug: brand.slug }, props: { brand, detail: entry.data as unknown as BrandReviewDetail } }] : [];
  });
}

interface Props {
  brand: BrandInfo;
  detail: BrandReviewDetail;
}

const { brand, detail } = Astro.props;

// 优先采用个性化 H1、副标题与 SEO 元信息
const pageH1 = detail?.h1 || `${brand.name}怎么样？2026年套餐价格、线路特色与使用指南`;
const pageSubtitle = detail?.subtitle || `深度测评 · 全面评测【${brand.name}】骨干网络质量与选购建议`;
const pageTitle = detail?.seoTitle || `${brand.name}怎么样？2026最新测评、套餐价格与优惠码指南 · ${site.name}`;
const pageDescription = detail?.seoDescription || detail?.leadSummary || `2026年最新${brand.name}深度测评：涵盖${brand.lineType}专线架构、晚高峰${brand.speed}实测速率、延迟表现、套餐方案价格与选购避坑指南。`;

// 提取最低套餐名、价格、流量、协议、支付方式与使用方式（100% 严格采信 jichangbuy 数据库）
const lowestSummary = detail?.pricing?.lowestPlanSummary;
const lowestPlan = detail?.pricing?.plans?.[0];
const lowestPlanName = lowestSummary?.name || lowestPlan?.name || '基础月付方案';
const lowestPlanTraffic = lowestSummary?.traffic || lowestPlan?.traffic || '100GB/月';
const lowestPlanPrice = lowestSummary?.displayPrice || brand.minMonthly;
const currentCouponCode = detail?.pricing?.couponInfo?.code || brand.coupon;
const currentCouponDiscount = detail?.pricing?.couponInfo?.discount || brand.couponDiscount;
const protocolsText = detail?.features?.protocols || 'VLESS / Shadowsocks';
const isPrimary = brand.category === 'primary';
const usageMethod = isPrimary 
  ? '专属客户端，下载登录即用（不提供订阅链接）' 
  : '官方专属客户端 / 通用标准订阅导入';
const paymentMethods = '支付宝 / 微信支付 / USDT (TRC20)';

// 提取当前品牌的 5 节点测速报告
const speedReport = brandSpeedTestMap[brand.slug];

// 最新一次测试的关键数值，以及已完成测试的品牌（用于 06 节底部的测速入口）
const test = testSummary(detail?.latestTest);
const testedBrands = (await getCollection('reviews'))
  .filter(r => (r.data as unknown as BrandReviewDetail).latestTest)
  .map(r => (r.data as unknown as BrandReviewDetail).name);

// 提取当前品牌官方实际支持的所有周期类型，按标准化顺序排列
const standardPeriodOrder = ['月付', '季付', '半年付', '年付', '两年付', '三年付', '一次性'];
const availablePeriodsRaw = new Set<string>();
(detail?.pricing?.packageGroups || []).forEach(pkg => {
  pkg.periods.forEach(p => {
    if (p.period.includes('两年') || p.period.includes('二年')) availablePeriodsRaw.add('两年付');
    else if (p.period.includes('三年')) availablePeriodsRaw.add('三年付');
    else if (p.period.includes('半年')) availablePeriodsRaw.add('半年付');
    else if (p.period.includes('年')) availablePeriodsRaw.add('年付');
    else if (p.period.includes('季')) availablePeriodsRaw.add('季付');
    else if (p.period.includes('月')) availablePeriodsRaw.add('月付');
    else if (p.period.includes('一次性') || p.period.includes('不限时')) availablePeriodsRaw.add('一次性');
  });
});
const distinctPeriods = standardPeriodOrder.filter(sp => availablePeriodsRaw.has(sp));

