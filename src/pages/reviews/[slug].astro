  /* 06 最新实测区块 */
  .latest-test {
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.28);
    border-radius: 12px;
    padding: 20px 22px;
    margin: 6px 0 22px;
  }
  .lt-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    color: #34d399;
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(16, 185, 129, 0.35);
    padding: 2px 9px;
    border-radius: 999px;
  }
  .lt-head h3 { margin: 10px 0 6px; font-size: 18px; color: #ffffff; }
  .lt-env { margin: 0; font-size: 12.5px; color: #94a3b8; line-height: 1.8; }
  .lt-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 16px 0; }
  .lt-metric em { display: block; margin-top: 4px; font-size: 11px; font-style: normal; color: #64748b; }
  .lt-checks { margin: 0 0 16px; display: grid; gap: 8px; }
  .lt-checks div { display: grid; grid-template-columns: 170px 1fr; gap: 12px; padding: 10px 12px; background: #0f1118; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; }
  .lt-checks dt { font-size: 13px; font-weight: 700; color: #e2e8f0; }
  .lt-checks dd { margin: 0; font-size: 12.5px; color: #94a3b8; line-height: 1.7; }
  .lt-metric { background: #0f1118; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; padding: 12px 14px; }
  .lt-metric span { display: block; font-size: 12px; color: #94a3b8; }
  .lt-metric strong { display: block; margin-top: 4px; font-size: 20px; color: #ffffff; font-variant-numeric: tabular-nums; }
  .lt-label { font-size: 13px; color: #cbd5e1; font-weight: 600; }
  .lt-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 6px; }
  .lt-chip { font-size: 12.5px; color: #e2e8f0; background: #0f1118; border: 1px solid rgba(255, 255, 255, 0.1); padding: 3px 10px; border-radius: 999px; }
  .lt-chip b { color: #34d399; font-weight: 600; margin-left: 4px; }
  .lt-small { margin: 6px 0 0; font-size: 12.5px; color: #94a3b8; line-height: 1.8; }
  .lt-images { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 16px; }
  .lt-images figure { margin: 0; }
  .lt-images img { display: block; width: 100%; height: auto; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.1); }
  .lt-images figcaption { margin-top: 6px; font-size: 12px; color: #94a3b8; line-height: 1.6; }
  .lt-note { margin: 14px 0 0; font-size: 12.5px; color: #fbbf24; line-height: 1.8; }
  .lt-zoom { display: block; cursor: zoom-in; }

  /* 截图大图查看 */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    background: rgba(5, 6, 10, 0.88);
    backdrop-filter: blur(4px);
  }
  .lightbox[hidden] { display: none; }
  .lb-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 14px 16px 6px;
  }
  .lb-toolbar button {
    min-width: 42px;
    height: 38px;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.25);
