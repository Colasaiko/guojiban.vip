---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articleSchema } from '../../utils/schema';
export async function getStaticPaths() { return (await getCollection('topics')).map(topic => ({params:{slug:topic.id},props:{topic}})); }
const {topic} = Astro.props;
const {Content} = await render(topic);
const schema = articleSchema({ title: topic.data.title, description: topic.data.description, path: `/topics/${topic.id}/`, published: topic.data.updatedDate, modified: topic.data.updatedDate });
const allPosts = await getCollection('blog', ({data}) => !data.draft);
// 优先使用专题里手动排序的文章；没有时按分类聚合
const posts = topic.data.posts.length
  ? topic.data.posts.map(id => allPosts.find(p => p.id === id)).filter(p => p !== undefined)
  : allPosts.filter(p => topic.data.categories.includes(p.data.category));
---
<BaseLayout title={topic.data.title} description={topic.data.description} type="article"><script type="application/ld+json" set:html={JSON.stringify(schema)} /><div class="container"><Breadcrumb items={[{label:'专题指南',href:'/topics/'},{label:topic.data.title}]} /><header class="page-heading"><span class="eyebrow">TOPIC GUIDE · 专题指南 · 更新于 {topic.data.updatedDate.toISOString().slice(0, 10)}</span><h1>{topic.data.title}</h1><p>{topic.data.description}</p></header><div class="prose"><Content /></div><section class="section"><h2>专题相关文章</h2><div class="article-grid">{posts.map(post => <ArticleCard post={post} />)}</div></section></div></BaseLayout>
