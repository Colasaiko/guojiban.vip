  .cpi-system-badge {
    font-size: 12px;
    font-weight: 600;
    color: #34d399;
    background: rgba(52, 211, 153, 0.12);
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid rgba(52, 211, 153, 0.25);
