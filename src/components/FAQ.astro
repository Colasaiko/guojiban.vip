---
import { faqs } from '../data/site';
---
<section class="section faq-section"><div><span class="eyebrow">GOOD TO KNOW</span><h2>你可能想知道</h2><p class="muted">开始探索之前，先了解这里。</p></div><div class="faq-list">{faqs.map(faq => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></section>
